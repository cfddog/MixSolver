# ─────────────────────────────────────────────────────────────
# MixNSSolver .gitignore
# （原待办：git init 时补 .gitignore —— build/、bin/）
# ─────────────────────────────────────────────────────────────

# 构建产物：可执行 / 对象 / 模块输出目录
build/
bin/

# 编译中间产物（防止散落到源码树）
*.o
*.mod

# Python 缓存（工具脚本 cases/**/**.py）
__pycache__/
*.pyc

# 编辑器 / 系统临时文件
*.swp
*~
.DS_Store

# 注意：lib/{metis,parmetis,tecplot}/*.a 为 vendored 预编译第三方库，
#       链接必需且不可由本仓库重建，故 **不** 忽略 *.a。
