# c3 -- 2D 圆环稳态纯导热，内外壁定温（对数解析解）
#
# 网格 c3_annulus.cas：极坐标 Nr=20 x Nt=72 x 1，
#       RI = 0.01 m，RO = 0.03 m，z in [0, 0.002] m，全部胞 CZ_SOLID=3。
# 边界：r=RI（zone 5）定温 300 K，r=RO（zone 6）定温 500 K，
#       z=0/LZ（zone 4）绝热（symmetry），theta 方向闭合周期。
# 解析解（轴对称、无内热源、与 k_s 无关）：
#       T(r) = 300 + 200 * ln(r/RI) / ln(RO/RI)
#       r = 0.02 m（径向中点）-> T = 300 + 200*ln2/ln3 = 426.19 K
#
# 该算例检验非正交/非笛卡尔网格上（面法向不与 r 对齐）的固体导热装配与
# 壁面定温边界是否正确。
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
alpha_u = 1.0
alpha_p = 0.3
outer_max = 3000
outer_tol = 1.0e-6
lin_tol   = 1.0e-12
lin_max   = 1000
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 400.0

cell_zone = 2 solid k_s=15.0 cp_s=460.0 rho_s=7800.0 q_src=0.0

bc = 4 symmetry
bc = 5 wall
bc = 6 wall

tbc = 5 1 300.0
tbc = 6 1 500.0
