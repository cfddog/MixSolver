# c2 -- 1D 稳态纯导热，一端定壁温 + 一端绝热（均匀温度解析解）
#
# 网格 c2 = c1_1d.cas（40x2x1 直棒，L = 0.1 m，全部胞为 CZ_SOLID=3）。
# 边界：x=0（zone 6）定温 400 K；x=L（zone 7）**绝热**（pressure-outlet
#       只给压力基准，未给 tbc -> ttype = 0 = 绝热）；
#       y / z 四个侧面绝热。
# 解析解：无内热源 + 除 x=0 外全绝热 -> T(x) = 400 K（处处相同）。
#
# 该算例同时检验“绝热壁 = 零热流 = 不写入任何 tbc”这条约定，以及固体
# 区域在完全闭合绝热边界下的定常解唯一性。
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
alpha_u = 1.0
alpha_p = 0.3
outer_max = 2000
outer_tol = 1.0e-6
lin_tol   = 1.0e-12
lin_max   = 1000
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 390.0            # 故意偏离解析解 400 K，检验确实收敛过去

cell_zone = 2 solid k_s=15.0 cp_s=460.0 rho_s=7800.0 q_src=0.0

bc = 4 wall
bc = 5 wall
bc = 6 wall
bc = 7 pressure-outlet 0.0

tbc = 6 1 400.0
# zone 7 不给 tbc -> 绝热（零温度梯度）
