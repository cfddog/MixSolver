# Betchen 2006 HT case B (LTNE block + 2 mm upstream air gap)
# ----------------------------------------------------------------
# Blocks: zone 2 fluid air gap x in [0,2mm]; zone 3 VC:porous foam block
# x in [2mm,116mm].  Same foil params / BCs as case A; bottom wall heated
# along the whole domain (gap + block), matching case A's condition at the
# start of the block.  Verifies the fluid/porous energy-matching jump.
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
cp  = 1005.0
k_cond = 0.026
alpha_u = 0.7
alpha_p = 0.3
outer_max = 20000
outer_tol = 1.0e-9
lin_tol   = 1.0e-10
lin_max   = 500
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

thermal_model = ltne
cell_zone = 3 porous perm=1.8e-7 inertial=0.0 porosity=0.9118 k_s=6.46 cp_s=900.0 rho_s=2700.0 h_sf=128.5 a_sf=139.3

bc = 6 symmetry
bc = 7 wall
bc = 8 wall
bc = 9 velocity-inlet 1.0 0.0 0.0 300.0
bc = 10 pressure-outlet 0.0
tbc = 8 1 310.0