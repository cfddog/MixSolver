# Betchen 2006 HT case A (LTNE bottom-heated aluminium foam block)
# ----------------------------------------------------------------
# Block y in [0,H=45mm], x in [0,L=114mm], zone 2 VC:porous.
# Calmidi-Mahajan Sample 2: eps=0.9118, K=1.8e-7, cE=0.085.  Air @300K.
# U=1.0 m/s mean (uniform inlet, paper uses fully-developed profile).
# Bottom y=0 heated wall (tbc = constant T, type 1), top y=H adiabatic.
# h_sf=128.5 W/m2K from the Nu_sf correlation; a_sf=139 m2/m3 (foam approx);
# k_eff split: fluid eps*kf, solid (1-eps)*ks.
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
cp  = 1005.0
k_cond = 0.026
alpha_u = 0.7
alpha_p = 0.3
outer_max = 20000
outer_tol = 1.0e-9
lin_tol   = 1.0e-10
lin_max   = 500
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

thermal_model = ltne
cell_zone = 2 porous perm=1.8e-7 inertial=0.0 porosity=0.9118 k_s=6.46 cp_s=900.0 rho_s=2700.0 h_sf=128.5 a_sf=139.3

bc = 6 symmetry
bc = 7 wall
bc = 8 wall
bc = 9 velocity-inlet 1.0 0.0 0.0 300.0
bc = 10 pressure-outlet 0.0
tbc = 8 1 310.0