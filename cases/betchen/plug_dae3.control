# Betchen 2006 PLUG case, Da=1e-3 (default Re_H=1)
# ----------------------------------------------------------------
# Channel y in [0,H] (H=0.01 m); x = 3H fluid | 2H porous | 3H fluid.
# Re_H = rho*U0*H/mu = 1  =>  U0 = mu/(rho*H) = 1.5684e-3 m/s
# Da = K/H^2 = 1e-3 => K=1e-7 m^2.  Inlet: paper's fully-developed
# parabolic profile u(y)=6*U0*(y/H)*(1-y/H) (peak 1.5*U0, mean U0) imposed
# directly by 'velocity-inlet-parabolic Umean H y0 [T]' (axis 2 = y,
# y0 = 0 = lower wall).  Mean speed = U0, so the flow rate equals the old
# uniform inlet; only the shape differs.  The 3H upstream segment is kept
# (it also lets residual inlet-FV error decay before the bed).
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
alpha_u = 0.7
alpha_p = 0.3
outer_max = 3000
outer_tol = 1.0e-8
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

cell_zone = 3 perm=1.0e-7 porosity=0.7

bc = 6 symmetry
bc = 7 wall
bc = 8 wall
bc = 9 velocity-inlet-parabolic 1.5684e-3 0.01 2 0.0 300.0
bc = 10 pressure-outlet 0.0