# LTNE 1D porous slab, baseline WITHOUT longitudinal dispersion
# ----------------------------------------------------------------
# Strictly 1D SI-metre duct (gen_ltne1d.py): x in [0,0.05] m, all four
# side faces symmetry; mass-flow-inlet G=2 kg/m^2/s at x=0, pressure-outlet
# at x=L doubles as the constant-heat-flux end face (tbc zone 7).
#
# Air at 300 K forced through an SS304 porous matrix (eps=0.3, K=1e-8).
# h*a = 2e5 W/m^3/K gives the interphase exchange length
#   l_ex = sqrt((1-eps)*k_s/(h*a)) = sqrt(11.34/2e5) = 7.54 mm = 15 dx.
# Reference: full 4th-order two-phase ODE system incl. fluid axial
# conduction eps*k_f (plot_ltne_disp.py).

mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
cp  = 1005.0
k_cond = 0.026
init_t = 300.0

thermal_model = ltne
cell_zone = 2 porous perm=1.0e-8 inertial=0.0 porosity=0.3 k_s=16.2 cp_s=500.0 rho_s=7900.0 h_sf=2.0e5 a_sf=1.0

alpha_u = 0.7
alpha_p = 0.3
outer_max = 20000
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 300
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1

bc = 4 symmetry
bc = 5 symmetry
bc = 6 mass-flow-inlet 2.0 300.0
bc = 7 pressure-outlet 0.0
tbc = 7 2 2.0e6
