# solid_conduction -- pure solid 1D conduction (phase 16) validation
# Mesh: 40x2x1 duct, L=0.1 m (plug.cas), every cell a CZ_SOLID conduction region.
# Steady 1D conduction hot(x=0)=400 K / cold(x=L)=300 K, adiabatic sides:
#   T(x) = 400 - 100*x/L   (linear), mid-wall x=0.05 -> T = 350 K.
# Independent of k_s (steady, no source).
mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
alpha_u = 0.7
alpha_p = 0.3
outer_max = 2000
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

# whole domain is a stationary solid conduction region (explicit type beats the
# mesh VC:porous tag; porosity becomes 0, no fluid phase, u=v=w=0)
cell_zone = 2 solid k_s=15.0 cp_s=460.0 rho_s=7800.0 q_src=0.0

# no through-flow: sides + faces are walls; keep x=L as pressure-outlet only to
# anchor the (motionless) pressure datum
bc = 4 wall
bc = 5 wall
bc = 6 wall
bc = 7 pressure-outlet 0.0

# thermal: hot wall at x=0 (zone 6), cold wall at x=L (zone 7); sides adiabatic
tbc = 6 1 400.0
tbc = 7 1 300.0
