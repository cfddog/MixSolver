# 1D porous plug, Darcy-only regime (inertial = 0)
# -------------------------------------------------
# Uniform 1D duct x in [0,0.1] m, all four side faces symmetry -> the
# solution is strictly 1D.  Cell zone 2 is tagged "VC:porous" in plug.cas;
# NOTE: no fluid|porous type token here -- the block type is inferred from
# the VC tag, this line supplies the coefficients only (CZ_AUTO).
#
# Tensor-path consistency: perm_xx only (yy,zz fall back to scalar perm=0)
# Darcy sink = mu/K*u (no 1/eps factor):
#   dp/dx = -(mu/K) u
#   dP    = 1.846e-5/1e-8 * 0.1 * 0.1 = 18.46 Pa
# Pore Reynolds number Re_p = rho u sqrt(K)/mu = 0.64 (Darcy regime).

mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
alpha_u = 0.7
alpha_p = 0.3
outer_max = 20000
outer_tol = 1.0e-9
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

cell_zone = 2 perm_xx=1.0e-8 porosity=0.4

bc = 4 symmetry
bc = 5 symmetry
bc = 6 velocity-inlet 0.1 0.0 0.0 300.0
bc = 7 pressure-outlet 0.0
