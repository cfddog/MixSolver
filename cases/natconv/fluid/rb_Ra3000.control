# Pure-fluid Rayleigh-Benard, Ra = 3e3 (still subcritical, onset 1708):
# pure conduction Nu ~ 1. Strong perturbation t_pert=0.15 to test stability
# of the conductive branch against finite-amplitude disturbances.

rho = 1.0
mu  = 2.781e-3
alpha_u = 0.7
alpha_p = 0.3
outer_max = 5000
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 400
conv_blend   = 1.0
nonorth_corr = 0.0
ppe_precond  = ic0

cp = 1.0
k_cond = 3.918e-3
boussinesq = true
beta = 3.33e-3
tref = 300.5
gravity = 0.0 -9.81 0.0
init_t = 300.5
t_pert = 0.15

bc = 5 wall
bc = 4 symmetry
tbc_plane = 5 2 0.0 1 301.0
tbc_plane = 5 2 1.0 1 300.0
