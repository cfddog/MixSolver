# Pure-fluid Rayleigh-Benard, Ra = 1e4 on the 80x80 mesh (grid refinement).
# Companion of rb_Ra1e4.control (40x40). Expected Nu ~ 2.145 (8264 iters).

rho = 1.0
mu  = 1.523e-3
alpha_u = 0.7
alpha_p = 0.3
outer_max = 30000
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 400
conv_blend   = 1.0
nonorth_corr = 0.0
ppe_precond  = ic0

cp = 1.0
k_cond = 2.146e-3
boussinesq = true
beta = 3.33e-3
tref = 300.5
gravity = 0.0 -9.81 0.0
init_t = 300.5
t_pert = 0.02

bc = 5 wall
bc = 4 symmetry
tbc_plane = 5 2 0.0 1 301.0
tbc_plane = 5 2 1.0 1 300.0
