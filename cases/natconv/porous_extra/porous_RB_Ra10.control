# Porous Rayleigh-Benard layer, heated from below (SUBCRITICAL test)
# Hot bottom y=0 (301), cold top y=1 (300), side walls adiabatic.
# Pure Darcy eps=1, Da=1e-6; Darcy-Rayleigh Ra_K = 10.
# Analytic onset for a porous layer: Ra_c = 4*pi^2 = 39.48 (Lapwood/HRL).
# Ra_K=10 < 39.48 -> no convection: u=0, pure conduction Nu=1.
# Same coefficients as porous_Ra10.control.

rho = 1.0
mu  = 5.7155e-5
alpha_u = 0.7
alpha_p = 0.3
outer_max = 10000
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 400
conv_blend   = 1.0
nonorth_corr = 0.0
ppe_precond  = ic0

cell_zone = 2 porous perm=1.0e-6 inertial=0.0 porosity=1.0

cp = 1.0
k_cond = 5.7155e-5
boussinesq = true
beta = 3.33e-3
tref = 300.5
gravity = 0.0 -9.81 0.0
init_t = 300.5
t_pert = 0.02

bc = 5 wall
bc = 4 symmetry
tbc_plane = 5 2 0.0 1 301.0
tbc_plane = 5 2 1.0 1 300.0
