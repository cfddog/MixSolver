# Beavers-Joseph validation: open channel, fluid over Darcy porous bed,
# driven by a uniform body force f = 0.05 N/m^3 (both ends pressure-outlet
# p=0, so the driving force per volume is exactly f; in a closed box a body
# force would be cancelled by the pressure gradient).
#
# Baseline alpha = 0: plain stress continuity at the fluid/porous interface
# (bj_alpha absent -> BJ branch bit-identically inactive).
#
# Analytic (eps=1 -> mu_eff=mu, G=f=0.05 Pa/m, H=5mm, K=1e-6, sigma=H/sqrt(K)=5):
#   u_D = K*G/mu = 2.710e-3 m/s
#   u_B = (G*H^2/(2*mu) + alpha*sigma*u_D)/(1+alpha*sigma)  (alpha=0 -> 3.385e-2)

mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
body_force = 0.05 0.0 0.0

alpha_u = 0.7
alpha_p = 0.3
outer_max = 800
outer_tol = 1.0e-9
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 1.0
nonorth_corr = 1.0
ppe_precond  = ic0
init_t = 300.0

cell_zone = 3 perm=1.0e-6 porosity=1.0

bc = 5 symmetry
bc = 6 wall
bc = 7 wall
bc = 8 pressure-outlet 0.0
bc = 9 pressure-outlet 0.0
tbc = 7 1 300.0
