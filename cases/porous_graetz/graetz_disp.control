# Graetz forced convection, WITH transverse thermal dispersion
# -------------------------------------------------------------
# Same geometry/BC as graetz_mol, U=1 m/s, alpha_t=2.5e-4 m.
# Effective transverse conductivity/diffusivity:
#   Gamma_y = k_eff + rho*cp*alpha_t*U
#           = 0.026 + 1.177*1005*2.5e-4*1 = 0.3217 W/m/K
#   kappa_eff = Gamma_y/(rho*cp) = 2.720e-4 m^2/s
# Pe = U*a/kappa_eff = 18.4 ; exit x* = kappa_eff*L/(U*a^2) = 4.90
# alpha_l = 0 so no streamwise dispersion is added (classical Graetz form).

mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
cp  = 1005.0
k_cond = 0.026
alpha_u = 0.7
alpha_p = 0.3
outer_max = 20000
outer_tol = 1.0e-9
lin_tol   = 1.0e-10
lin_max   = 500
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
inlet_ramp = 1
init_t = 300.0

cell_zone = 2 perm=1.0e-10 porosity=0.4 k_s=0.026 disp_t=2.5e-4

bc = 4 symmetry
bc = 5 symmetry
bc = 6 velocity-inlet 1.0 0.0 0.0 300.0
bc = 7 pressure-outlet 0.0
bc = 8 wall
tbc = 8 1 310.0
