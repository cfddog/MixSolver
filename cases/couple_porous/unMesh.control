# UNSolver control file -- couple_porous (unstructured side, SI)
# Hex mesh unMesh.cas (mm units -> mesh_scale), domain x=100..200 mm.
# The whole uns domain is ONE cell zone tagged "VC:porous" in unMesh.cas,
# so the solver infers the block type from the VC tag; this line supplies
# the coefficients only (CZ_AUTO).
#
# Face zones:
#   zone 4 = symmetry (z planes), zone 5 = symmetry (y=0/H),
#   zone 6 = pressure-outlet (x=200 mm), zone 7 = coupling interface (x=100)
#
# Matched to the structured side: T=300 K air, Ma=0.1 (u=34.72 m/s),
# physical mu=1.846e-5 Pa.s.
#
# Analytical bed pressure drop (L=0.1 m):
#   dP = (mu/eps/K) u L + rho beta u^2 L
#      = 1.846e-5/0.4/1e-6*34.7224*0.1 + 1.177*1.0*34.7224^2*0.1
#      = 160.2 + 141.9 = 302.1 Pa
# -------------------------------------------------------------------------

# --- mesh units: CAS file is in mm -> scale to m ---
mesh_scale = 1.0e-3

# --- physical properties ---
rho = 1.177
mu  = 1.846e-5

# --- numerical parameters (SIMPLE) ---
alpha_u = 0.7
alpha_p = 0.3
outer_max = 200
outer_tol = 1.0e-6
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 0.0
nonorth_corr = 1.0
ppe_precond  = ic0
# inlet_ramp=1 in coupled cases: driver-level mass correction must not fight
# a desynchronised ramp (lessons learned).
inlet_ramp = 1

# --- initial temperature field (interface T exchange) ---
init_t = 300.0

# --- cell (volume) zone: VC tag says porous; coefficients only ---
cell_zone = 2 perm=1.0e-6 inertial=1.0 porosity=0.4

# --- boundary conditions ---
bc = 4 symmetry
bc = 5 symmetry
bc = 6 pressure-outlet 0.0
# zone 7 "interface" needs no bc: handled by the coupling exchange layer
