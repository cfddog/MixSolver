$(call coupl_objm,$(COUPL_LAYER1)): $(call coupl_objm,$(COUPL_LAYER0))
$(call coupl_objs,$(COUPL_LAYER2)): $(call coupl_objs,$(COUPL_LAYER0) $(COUPL_LAYER1))
$(call coupl_objm,$(COUPL_LAYER2)): $(call coupl_objm,$(COUPL_LAYER0) $(COUPL_LAYER1))

