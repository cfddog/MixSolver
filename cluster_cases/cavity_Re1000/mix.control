# MixNSSolver self-dispatching mode file (required, zero-argument binary).
#   mode = uns      -> unstructured incompressible solver (this scene)
#   mode = coupled  -> struct + uns weak coupling
#   mode = struct   -> structured compressible solver
# The unstructured mode reads unMesh.cas + unMesh.control from the cwd and
# writes the result named after the .cas basename (unMesh.vtu), plus optional
# unMesh.vtu_step<NNNNNNN>.vtu snapshots when enabled by the control file.
mode = uns

# Use the MPI driver so the case exercises the partitioned SIMPLE path,
# including for a single-rank launch (./run.sh 1).
uns_parallel = always

# Optional authoritative rank split: sum = n_struct_ranks + n_uns_ranks must
# equal the launched rank count (-np / --ntasks).  Uncomment BOTH (never just
# one) to have the launch checked; run.sh also defaults its np to this sum.
# n_struct_ranks = 0
# n_uns_ranks    = 4
