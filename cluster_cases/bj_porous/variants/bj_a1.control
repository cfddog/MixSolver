# =========================================================================
# CLUSTER SCENE: Beavers-Joseph (fluid / Darcy-porous interface), alpha = 1
# -------------------------------------------------------------------------
# Mesh: unMesh.cas  (= cases/beavers_joseph/bj.cas, generated by gen_bj.py)
#   2D open channel, x in [0,0.1] m, y in [0,0.01] m, 100 x 40 x 1 hexes;
#   upper half y in [5,10] mm = fluid (zone 2), lower half = porous bed
#   (zone 3, VC:porous), H = 5 mm per layer, K = 1e-6 m^2, eps = 1.
#   zones: 5 = symmetry (z = 0 / z = 1), 6 = wall (y = 10 mm),
#          7 = wall (y = 0), 8 = pressure-outlet (x = 0), 9 = (x = L).
#   Driving force: uniform body force f = 0.05 N/m^3 (both ends p = 0).
#   Air: rho = 1.177 kg/m^3, mu = 1.846e-5 Pa s.
#
# Reference = two-layer coupled ODE solution (fluid + Brinkman), NOT the
# classical BJ slip formula (see cases/beavers_joseph/README.md section 2):
#   u_D = K*f/mu = 2.710e-3 m/s (Darcy plug), u_B(alpha=1) = 7.893e-3 m/s.
# Archived validation (cases/beavers_joseph/README.md section 4, alpha=1):
#   first fluid cell u_num = 1.173e-2 vs u_ref(dy/2) = 1.212e-2, RMS 1.09%.
#
# Differences from the archived cases/beavers_joseph/bj_a1.control:
#   1. No thermal boundary condition and no init_t.  The scene is isothermal
#      (rho, mu constant, no buoyancy) but the solver still advects/diffuses
#      a passive T.  The archived control pinned only zone 7 (bed bottom) at
#      300 K, so T drifted away (T_min -> 53 K by it = 800) and dT_max never
#      approached outer_tol; pinning BOTH walls at 300 K is not enough either
#      -- the porous bed then pulls the field down to a ~88 K steady state
#      (measured, dT_max still 1.5e-4 after 1200 iterations) -- so the
#      convergence test (imbal AND du_max AND dT_max < outer_tol, see
#      src/unstructured/mod_uns_simple.f90 line 235) could never fire.
#      With the walls left adiabatic (ttype = 0 default) and T initialised to
#      0 (the default) the passive field stays EXACTLY 0 (dT_max = 0.000E+00
#      from it = 1) and the run converges on the velocity alone.
#   2. outer_max 800 -> 2000: the archived run stopped at the cap with
#      du_max = 3.1e-9 (outer_tol = 1e-9), i.e. "reached outer_max"; 2000
#      lets the scene finish with an explicit CONVERGED line.
#   T is passive here (constant properties, no buoyancy), so the velocity
#   field is unaffected: the archived uF1 / RMS values are reproduced
#   (numbers in this bundle's README.md).
# =========================================================================

mesh_scale = 1.0
rho = 1.177
mu  = 1.846e-5
body_force = 0.05 0.0 0.0

alpha_u = 0.7
alpha_p = 0.3
outer_max = 2000
outer_tol = 1.0e-9
lin_tol   = 1.0e-8
lin_max   = 200
conv_blend   = 1.0
nonorth_corr = 1.0
ppe_precond  = ic0

cell_zone = 3 perm=1.0e-6 porosity=1.0 bj_alpha=1.0

bc = 5 symmetry
bc = 6 wall
bc = 7 wall
bc = 8 pressure-outlet 0.0
bc = 9 pressure-outlet 0.0
